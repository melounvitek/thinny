{
  "max_age_hours": 26,
  "jobs": [
    {
      "name": "Hermes nightly update",
      "kind": "hermes-update",
      "host": "<user>@<server>"
    },
    {
      "name": "Nightly snapshot",
      "kind": "netcup-snapshot",
      "host": "<user>@<snapshot machine>",
      "file": "<snapshot dir>/status.json"
    }
  ]
}
