#!/bin/sh
# One-line install, as root or as a user with sudo:
#   bash -o pipefail -c 'curl -fsSL https://raw.githubusercontent.com/melounvitek/thinny/main/bin/install | bash'
# Git, a clone of thinny in /usr/local/src/thinny (kept when there is one), then its install.sh.
set -eu

REPOSITORY=https://github.com/melounvitek/thinny.git
SRC=/usr/local/src/thinny
TTY=
(exec </dev/tty) 2>/dev/null && TTY=1

# With sudo, on the terminal rather than this script's pipe: with a pipe, Ubuntu 26.04's sudo-rs runs
# the command in the background, where the first question stops it.
as_root() {
	if [ "$(id -u)" = 0 ]; then
		"$@"
	elif [ -n "$TTY" ]; then
		sudo "$@" </dev/tty
	else
		sudo "$@"
	fi
}

if [ -n "$TTY" ] && [ ! -f /etc/thinny/site.toml ]; then
	cat <<-EOF
	thinny is meant for a dedicated server, not a desktop or a shared machine. It sets up:
	  - Incus containers, with their own firewall table and IP forwarding
	  - a storage pool of up to 80% of the free disk space
	  - user namespaces for every account (Ubuntu restricts them by default)
	  - a nightly update that runs as root
	EOF
	printf "Continue? [y/N] "
	read -r answer </dev/tty
	case $answer in
	[yY]*) ;;
	*) echo "Nothing installed."; exit 1 ;;
	esac
fi

if ! command -v git >/dev/null; then
	echo "Installing git"
	as_root apt-get update -q >/dev/null
	as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -q git >/dev/null
fi
if [ ! -d "$SRC/.git" ]; then
	echo "Downloading thinny into $SRC"
	as_root git clone -q "$REPOSITORY" "$SRC"
fi
as_root sh "$SRC/install.sh"
