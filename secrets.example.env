# thinny's tokens: /etc/thinny/secrets.env. Only root can read it. Never show or share it, not even in part.
# Edit with: thinny config edit --secrets. One NAME=value per line, without quotes. For one run, an environment
# variable of the same name overrides it (see README, Settings).

# The token of the bot that creates each instance's own bot (see README, Telegram):
# THINNY_TELEGRAM_MANAGER_TOKEN=

# The Purelymail account's API token (see README, Email):
# THINNY_PURELYMAIL_API_TOKEN=

# The backups' passphrase, which thinny backup init creates (see README, Backups). Keep a copy off this server:
# THINNY_BACKUP_PASSPHRASE=
